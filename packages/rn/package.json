  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "chat",
    "sdk",
    "react-native",
    "expo",
    "support",
    "widget"
  ],
  "author": "HolyLabs",
  "license": "UNLICENSED",
  "peerDependencies": {
    "@holylabs/chat-sdk": "*",
    "react": ">=18",
    "react-native": ">=0.73",
    "firebase": ">=10",
    "expo-linear-gradient": ">=12"
  },
  "peerDependenciesMeta": {
    "expo-linear-gradient": {
      "optional": true
    }
  },
  "devDependencies": {
    "@holylabs/chat-sdk": "*",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
