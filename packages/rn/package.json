{
  "name": "@holylabs/chat-sdk-rn",
  "version": "0.2.0",
  "description": "React Native floating support widget for @holylabs/chat-sdk. Drop-in <SupportWidget /> with FAB + chatbox.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
