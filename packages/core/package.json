{
  "name": "@holylabs/chat-sdk",
  "version": "1.0.0",
  "description": "Drop-in chat infrastructure SDK. Talks to a chat-admin REST API and Supabase Realtime — no Firebase required on the consumer side.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "chat",
    "sdk",
    "supabase",
    "realtime",
    "support",
    "marketplace"
  ],
  "author": "HolyLabs",
  "license": "UNLICENSED",
  "peerDependencies": {
    "@supabase/supabase-js": ">=2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
